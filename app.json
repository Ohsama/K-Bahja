{
  "expo": {
    "name": "Bahja",
    "slug": "bahja-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/golden_b_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/dee655b1-61da-4692-b9a7-d2e8800cc134"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bahja.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/golden_b_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bahja.app",
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dee655b1-61da-4692-b9a7-d2e8800cc134"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "owner": "oussamaboukhalfa05"
  }
}
